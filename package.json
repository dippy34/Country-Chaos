{
  "name": "lightcone",
  "version": "0.1.0",
  "private": true,
  "description": "Lightcone — a relativistic VR space-flight simulator (WebXR) with Kerr black holes at true scale.",
  "type": "module",
  "license": "MIT",
  "scripts": {
